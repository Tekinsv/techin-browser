{
  "name": "techin-browser",
  "productName": "Techin Browser",
  "version": "1.0.7",
  "description": "A fast, private, Chromium-based browser with an Arc-style sidebar",
  "author": "Tekin",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "selftest": "electron . --selftest",
    "selftest:full": "electron . --selftest --drm",
    "icons": "electron scripts/make-icons.js",
    "vmp:dev": "python -m castlabs_evs.vmp sign-pkg node_modules/electron/dist",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.techin.browser",
    "productName": "Techin Browser",
    "copyright": "Techin Browser",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*",
      "!node_modules/electron/**/*"
    ],
    "afterPack": "scripts/after-pack.js",
    "afterSign": "scripts/after-sign.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Techin Browser",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Techin-Browser-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Tekinsv",
        "repo": "techin-browser",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "electron-updater": "^6.8.9",
    "tldts": "^7.4.15"
  }
}
