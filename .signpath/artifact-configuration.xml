<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration (paste into the SignPath project as the
     default artifact configuration). The release workflow uploads one .exe per
     signing request: first Techin Browser.exe, then the NSIS installer. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*.exe" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
